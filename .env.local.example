# Copie este arquivo para ".env.local" e preencha o que fizer sentido.
# Nenhuma dessas variáveis é obrigatória: o site funciona sem elas, cada
# uma só liga uma integração quando você preenche o valor.

# Número de WhatsApp da barbearia (só dígitos, com DDI 55).
NEXT_PUBLIC_WHATSAPP_NUMBER=5547984627509

# URL do sistema de agendamento (ex.: agendas.link, Trinks, Booksy).
# Sem isso, o botão "Agendar Horário" abre o WhatsApp automaticamente.
NEXT_PUBLIC_BOOKING_URL=https://agendas.link/macedo

# Nota e avaliações reais do Google, atualizadas sozinhas (ver lib/google-reviews.ts).
# GOOGLE_PLACES_API_KEY: crie em console.cloud.google.com, ative a "Places API"
# e gere uma chave de API.
# GOOGLE_PLACE_ID: encontre em https://developers.google.com/maps/documentation/places/web-service/place-id
# procurando por "Barbearia Macedo" no endereço de Blumenau/SC.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Analytics (opcional). Cada um só carrega script se o valor existir, e
# nenhum bloqueia o carregamento inicial da página (ver components/Analytics.tsx).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Chave da API da Anthropic (server-side apenas, NUNCA prefixar com NEXT_PUBLIC_).
# Sem isso, o chat do site responde só com os fluxos guiados (dados reais de
# /data/barbershop.ts) e uma mensagem padrão para perguntas livres, sem chamar
# nenhuma IA. Com a chave preenchida, perguntas fora dos fluxos guiados passam
# a ser respondidas por IA, sempre restrita ao mesmo contexto de dados reais
# (ver app/api/chat/route.ts e lib/chat/prompts.ts).
ANTHROPIC_API_KEY=
